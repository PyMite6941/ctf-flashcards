# Backend API base URL (defaults to http://localhost:8000 if unset)
VITE_API_URL=http://localhost:8000

# Clerk publishable key — enables account sign-in / connect-accounts.
# Get it from https://dashboard.clerk.com  →  your app  →  API Keys.
# Leave BLANK to run in zero-key demo mode (no auth, shared deck).
VITE_CLERK_PUBLISHABLE_KEY=

# --- Pro billing (routes through your GRID Store) ---
# The grid-store worker that verifies USDC-on-Base payments + mints licenses.
VITE_LICENSE_API=https://grid-store-worker.greshamd27.workers.dev
# Store wallet that receives the USDC (must match the worker's PAYMENT_WALLET).
VITE_PAYMENT_WALLET=0x8069408a17B77895cb7Cd0B0D804aB46f59Bc4c3
# Your storefront (for links).
VITE_STORE_URL=https://grid-store.pages.dev
